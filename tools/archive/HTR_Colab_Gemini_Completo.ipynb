    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Script HTR (Cyclo completo com Gemini 3 Flash)",
        "Prompt melhorado com contexto das freguesias e datas."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import base64, json, time, os, re",
        "from PIL import Image",
        "from io import BytesIO",
        "import urllib.request",
        "",
        "def process_image(img_path):",
        "    img = Image.open(img_path).convert('RGB')",
        "    buf = BytesIO()",
        "    img.save(buf, format='JPEG', quality=85)",
        "    b64 = base64.b64encode(buf.getvalue()).decode()",
        "    ",
        "    prompt = '''You are a transcription assistant for Portuguese historical documents.",
        "Context: You are processing death registers (livros de óbitos) from various parishes (freguesias) in Portugal:",
        "- Celorico da Beira (Santa Maria, São Pedro, São Martinho)",
        "- Document periods: 1711-1748, 1748-1762, 1772-1810, 1811-1854, 1854-1900+",
        "",
        "Tasks:",
        "1. Transcribe ALL handwritten text (preserve line breaks)",
        "2. Extract structured data for each deceased person:",
        "",
        "Output ONLY a JSON object (no markdown, no explanation):",
        "{",
        "  \"transcription\": \"full transcribed text here\",",
        "  \"deceased\": [",
        "    {",
        "      \"name\": \"person full name (D. Maria Silva)\",
        "      \"death_date\": \"YYYY-MM-DD\",",
        "      \"age\": \"age if mentioned\",",
        "      \"father\": \"father's name\",",
        "      \"mother\": \"mother's name\",",
        "      \"spouse\": \"spouse's name\",",
        "      \"parish\": \"freguesia name\"",
        "    }",
        "  ]",
        "}",
        "",
        "CRITICAL RULES:",
        "- For death_date: ALWAYS use ISO format (YYYY-MM-DD). Convert Portuguese dates.",
        "- If you cannot read something: use [ilegível]",
        "- NEVER invent content.",
        "'''",
        "",
        "    payload = {",
        "        'contents': [{'parts': [",
        "            {'text': prompt},",
        "            {'inline_data': {'mime_type': 'image/jpeg', 'data': b64}}",
        "        ]}],",
        "        'generationConfig': {'temperature': 0.1, 'maxOutputTokens': 2000}",
        "    }",
        "",
        "    data = json.dumps(payload).encode()",
        "    url = f'https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key={GEMINI_API_KEY}'",
        "    req = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'})",
        "    ",
        "    with urllib.request.urlopen(req, timeout=60) as resp:",
        "        result = json.loads(resp.read())",
        "        text = result['candidates'][0]['content']['parts'][0]['text']",
        "        ",
        "        # Parse JSON from response",
        "        try:",
        "            # Remove markdown if present",
        "            text_clean = text.strip()",
        "            if text_clean.startswith('```'):",
        "                text_clean = text_clean.split('```')[1]",
        "                if text_clean.startswith('json'):",
        "                    text_clean = text_clean[4:]",
        "            return json.loads(text_clean)",
        "        except:",
        "            return {'transcription': text, 'deceased': []}",
        "",
        "# Lista de imagens",
        "os.makedirs('htr_output', exist_ok=True)",
        "images = sorted([os.path.join('full_images', f) for f in os.listdir('full_images') if f.endswith('.tiff')])",
        "print(f'Total imagens: {len(images)}')",
        "",
        "# Teste com 10 primeiras (depois remove [:10] para processar todas)",
        "for i, img_path in enumerate(images[:10]):  # ← REMOVE [:10] PARA PROCESSAR TODAS",
        "    try:",
        "        result = process_image(img_path)",
        "        output_file = os.path.join('htr_output', os.path.basename(img_path).replace('.tiff', '.json'))",
        "        with open(output_file, 'w') as f:",
        "            json.dump(result, f, indent=2, ensure_ascii=False)",
        "        print(f'[{i+1}/10] {os.path.basename(img_path)}: OK ({len(result.get(\"transcription\", \"\"))} chars)')",
        "        time.sleep(3)  # Rate limit: 1500 req/dia = ~3 dias para 4152 imagens",
        "    except Exception as e:",
        "        print(f'[{i+1}/10] {os.path.basename(img_path)}: Erro - {e}')",
        "",
        "print('Teste completo! Remove [:10] para processar todas as imagens.')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
