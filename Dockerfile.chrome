FROM selenium/standalone-chrome:120.0

# Instalar bibliotecas necessárias para WebGL/Canvas
USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libgl1-mesa-dri \
    mesa-vdpau-drivers \
    mesa-vulkan-drivers \
    libdrm2 \
    libgbm1 \
    libxcb-dri3-0 \
    libxcb-present0 \
    libxshmfence1 \
    libvulkan1 \
    && rm -rf /var/lib/apt/lists/*

# Variáveis de ambiente para WebGL
ENV MESA_GL_VERSION_OVERRIDE=3.3
ENV MESA_GLSL_VERSION_OVERRIDE=330
ENV LIBGL_ALWAYS_SOFTWARE=1

USER seluser