# ─── Gemini Vision API (OBRIGATÓRIO) ─────────────────────────────────────────
# Grátis em: https://aistudio.google.com/app/apikey
# Limite gratuito: 15 requests/min, 1500 req/dia
GEMINI_API_KEY=AIzaSy...

# ─── Base de dados SQLite (local) ─────────────────────────────────────────────
# Caminho da base de dados (criada automaticamente)
DB_PATH=output/genealogia.db

# ─── Opcional: FamilySearch ───────────────────────────────────────────────────
# Para sincronizar índices já transcritos. Cria conta gratuita em familysearch.org
FAMILYSEARCH_CLIENT_ID=
FAMILYSEARCH_CLIENT_SECRET=

# ─── Opcional: Transkribus ────────────────────────────────────────────────────
# 500 páginas/mês grátis. Melhor para manuscritos muito difíceis.
# Cria conta em transkribus.eu
TRANSKRIBUS_USER=
TRANSKRIBUS_PASS=

# ─── Legado (não necessário com Gemini) ──────────────────────────────────────
# GOOGLE_VISION_API_KEY=
# NVIDIA_API_KEY=
# SUPABASE_URL=
# SUPABASE_KEY=
