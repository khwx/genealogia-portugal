# ============================================================================
#  genealogia-portugal — ficheiro de exemplo de ambiente
#  Copia para `.env` e preenche os valores. O `.env` NUNCA é comitado.
#  Todos os segredos vêm daqui; o código lê via os.environ.get(...).
# ============================================================================

# ---- Supabase -------------------------------------------------------------
# URL do projeto (publico) e chaves.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave anon/publica (pode ir no cliente; nao e segredo, mas mantem no .env)
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chave de servico (SEGREDO — nunca no repo, nunca no cliente)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Alias usado por alguns scripts
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Gemini (Google AI) — OCR/HTR ----------------------------------------
# Usa GEMINI_KEYS (varias, separadas por virgula) OU GEMINI_API_KEY (uma).
GEMINI_KEYS=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelos a tentar (validados como funcionais nas chaves free tier):
# gemini-3.5-flash-lite tem RPD 500/dia (o mais rápido); os outros RPD 20/dia.
GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.7-flash

# Pacing / concorrência (todas as contas são free tier da API Gemini):
#   Limites free (site): RPD=20/dia por MODELO por chave; RPM=5/min por MODELO por chave.
#   O código respeita isto por (chave,modelo):
#     - KEY_INTERVAL: espaço (s) entre 2 pedidos ao MESMO (chave,modelo).
#       20/dia -> 86400/20 = 4320s. O gemini-3.5-flash-lite (RPD 500) usa 175s no código.
#     - RPM_INTERVAL: espaço (s) entre 2 pedidos ao MESMO modelo (qualquer chave).
#       5/min -> 12s (lite: 15/min -> 4s).
#   - CONCURRENT_REQUESTS: nº de workers em paralelo.
# Se vires muitos 429, o modelo é pausado até à meia-noite (quota diária).
KEY_INTERVAL=4320
RPM_INTERVAL=12
CONCURRENT_REQUESTS=8

# ---- Outros backends de HTR/OCR (opcionais) -------------------------------
HTR_BACKEND=gemini
HTR_MODEL=gemini-1.5-pro
GOOGLE_VISION_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_URL=http://localhost:11434

# ---- Transkribus (opcional) -----------------------------------------------
TRANSKRIBUS_USERNAME=
TRANSKRIBUS_PASSWORD=
TRANSKRIBUS_API_KEY=

# ---- FamilySearch (opcional) ----------------------------------------------
FAMILYSEARCH_USERNAME=
FAMILYSEARCH_PASSWORD=
FAMILYSEARCH_API_KEY=

# ---- Pinecone / Redis (opcionais) ----------------------------------------
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
REDIS_URL=redis://localhost:6379

# ---- Google Drive (opcional, para Colab) ---------------------------------
GOOGLE_DRIVE_FOLDER_ID=
COLAB_TOKEN=

# ---- Caminhos e parametros do pipeline (nao sao segredos) ----------------
INPUT_DIR=/home/utilizador/projetos/obitos/input
OUTPUT_DIR=/home/utilizador/projetos/obitos/output
METADATA_DIR=/home/utilizador/projetos/obitos/output/htr_metadata
STATE_FILE=/home/utilizador/projetos/obitos/output/htr_cloud_v2_state.json
LOG_FILE=/home/utilizador/projetos/obitos/output/htr.log
FREGUESIA_MAPPING_JSON=/home/utilizador/projetos/obitos/output/data/freguesia_file_mapping.json
CELORICO_JSON=/home/utilizador/projetos/obitos/output/data/celorico_inventory.json

# ---- Controlo de execucao (nao sao segredos) -----------------------------
BATCH_SIZE=10
CONCURRENT_REQUESTS=3
DELAY_BETWEEN_REQUESTS=1.0
REQUEST_TIMEOUT=120
MAX_RETRIES=3
RETRY_DELAY=5
JPEG_QUALITY=90
MAX_IMAGE_WIDTH=2000
MAX_IMAGE_HEIGHT=3000
DRY_RUN=false
