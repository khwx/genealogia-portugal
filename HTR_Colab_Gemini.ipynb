        "# HTR Batch - Celorico da Beira (Gemini 3 Flash)",
        "Processa as restantes ~2596 imagens de registos de óbitos via Gemini API.",
        "",
        "## 1. Configurar API Key",
        "Vai a https://aistudio.google.com/apikey → Create API key → Cola aqui:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Chave já configurada",
        "GEMINI_API_KEY = '""'",
        "print('Key configurada:', GEMINI_API_KEY[:20] + '...')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Fazer upload das imagens do servidor",
        "No servidor: `cd /home/pxtkhw/projetos/obitos && tar czf full_images.tar.gz output/full_images/`",
        "Depois faz upload do `full_images.tar.gz` aqui:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from google.colab import files",
        "import os",
        "",
        "print('Faz upload do full_images.tar.gz (3.7GB)...')",
        "# uploaded = files.upload()  # Descomenta para fazer upload",
        "",
        "os.makedirs('full_images', exist_ok=True)",
        "!tar xzf full_images.tar.gz -C . 2>/dev/null || echo 'Faz upload primeiro!'",
        "",
        "# Lista imagens disponíveis",
        "images = sorted([f for f in os.listdir('full_images') if f.endswith('.tiff')])",
        "print(f'Total imagens disponíveis: {len(images)}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Script HTR (processa todas as imagens)",
        "Usa Gemini 3 Flash para transcrever manuscritos."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import base64, json, time, os, re",
        "from PIL import Image",
        "from io import BytesIO",
        "import urllib.request",
        "",
        "def process_image(img_path):",
        "    img = Image.open(img_path).convert('RGB')",
        "    buf = BytesIO()",
        "    img.save(buf, format='JPEG', quality=85)",
        "    b64 = base64.b64encode(buf.getvalue()).decode()",
        "",
        "    prompt = '''You are a transcription assistant for Portuguese historical documents.",
        "Output ONLY a JSON object (no markdown) with this structure:",
        "{",
        "  \\\"transcription\\\": \\\"full transcribed text here\\\",",
        "  \\\"deceased\\\": [",
        "    {",
        "      \\\"name\\\": \\\"person name\\\",",
        "      \\\"death_date\\\": \\\"YYYY-MM-DD\\\"",
        "      \\\"age\\\": \\\"age if mentioned\\\"",
        "    }",
        "  ]",
        "}",
        "IMPORTANT: For death_date, ALWAYS use ISO format (YYYY-MM-DD). Output ONLY the JSON object.'''",
        "",
        "    payload = {",
        "        'contents': [{'parts': [",
        "            {'text': prompt},",
        "            {'inline_data': {'mime_type': 'image/jpeg', 'data': b64}}",
        "        ]}],",
        "        'generationConfig': {'temperature': 0.1, 'maxOutputTokens': 2000}",
        "    }",
        "",
        "    data = json.dumps(payload).encode()",
        "    url = f'https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key={GEMINI_API_KEY}'",
        "    req = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'})",
        "",
        "    with urllib.request.urlopen(req, timeout=60) as resp:",
        "        result = json.loads(resp.read())",
        "        text = result['candidates'][0]['content']['parts'][0]['text']",
        "        return text",
        "",
        "os.makedirs('htr_output', exist_ok=True)",
        "",
        "# Começa com 10 para testar (depois remove [:10] para processar todas)",
        "images = sorted([os.path.join('full_images', f) for f in os.listdir('full_images') if f.endswith('.tiff')])",
        "print(f'Total imagens: {len(images)}')",
        "",
        "for i, img_path in enumerate(images[:10]):  # Remove [:10] para processar todas",
        "    try:",
        "        result = process_image(img_path)",
        "        output_file = os.path.join('htr_output', os.path.basename(img_path).replace('.tiff', '.json'))",
        "        with open(output_file, 'w') as f:",
        "            json.dump({'raw_text': result}, f, indent=2, ensure_ascii=False)",
        "        print(f'[{i+1}/10] {os.path.basename(img_path)}: OK')",
        "        time.sleep(3)  # Rate limit (3 req/s = 1500/dia)",
        "    except Exception as e:",
        "        print(f'[{i+1}/10] {os.path.basename(img_path)}: Error - {e}')",
        "",
        "print('Teste completo! Remove [:10] para processar todas as 4152 imagens.')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Fazer download dos resultados",
        "Gera `htr_output.tar.gz` para fazer download:"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import tarfile",
        "from google.colab import files",
        "",
        "print('A criar htr_output.tar.gz...')",
        "with tarfile.open('htr_output.tar.gz', 'w:gz') as tar:",
        "    tar.add('htr_output')",
        "print('Download do ficheiro...')",
        "files.download('htr_output.tar.gz')",
        "print('Download pronto! Faz upload deste ficheiro para o servidor.')"
      ]
    }
  ],
